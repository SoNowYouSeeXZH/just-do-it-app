{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        },
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "jsx": "react-native",
        "lib": ["ESNext"],
        "types": ["react-native"],
        "moduleResolution": "bundler",
        "noEmit": true,
        "strict": true,
        "target": "esnext"
    },
    "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.js"],
    "extends": "expo/tsconfig.base"
}
